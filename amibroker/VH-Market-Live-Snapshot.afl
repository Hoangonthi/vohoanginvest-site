// =============================================================
// VÕ HOÀNG - MARKET LIVE SNAPSHOT V1
// Gắn AFL này vào chart intraday của VN-Index.
// Nhiệm vụ: chỉ xuất sự thật kỹ thuật ra CSV, không gọi AI/API.
// =============================================================

_SECTION_BEGIN("VH Market Live Snapshot");
SetBarsRequired(100000, 0);

snapshotEnable = ParamToggle("VH Live Snapshot CSV", "Off|On", 1);
snapshotFile = ParamStr("Snapshot File", "C:\\Users\\USER\\Desktop\\AMIBRO\\vh_market_live_snapshot.csv");

// ---------- Giá hiện tại / diễn biến trong ngày ----------
dn = DateNum();
lastBar = BarCount - 1;
lastValueNow = C[lastBar];
currentDate = dn[lastBar];

sessionHigh = H[lastBar];
sessionLow = L[lastBar];
sessionOpen = O[lastBar];
cumPV = 0;
cumV = 0;

for(i = lastBar; i >= 0; i--)
{
    if(dn[i] != currentDate) break;

    if(H[i] > sessionHigh) sessionHigh = H[i];
    if(L[i] < sessionLow) sessionLow = L[i];
    sessionOpen = O[i];

    typical = (H[i] + L[i] + C[i]) / 3;
    cumPV = cumPV + typical * V[i];
    cumV = cumV + V[i];
}

vwapNow = lastValueNow;
if(cumV > 0) vwapNow = cumPV / cumV;

// ---------- Chỉ báo DAILY: MA / RSI / MACD / mốc quá khứ ----------
TimeFrameSet(inDaily);

dPrevClose = LastValue(Ref(C, -1), 1);
dPrevHigh  = LastValue(Ref(H, -1), 1);
dPrevLow   = LastValue(Ref(L, -1), 1);
dMa10      = LastValue(MA(C, 10), 1);
dMa20      = LastValue(MA(C, 20), 1);
dMa50      = LastValue(MA(C, 50), 1);
dRsi14     = LastValue(RSI(14), 1);
dMacd      = LastValue(MACD(12, 26), 1);
dSignal    = LastValue(Signal(12, 26, 9), 1);
dHigh20    = LastValue(Ref(HHV(H, 20), -1), 1);
dLow20     = LastValue(Ref(LLV(L, 20), -1), 1);

TimeFrameRestore();

reference = dPrevClose;
changePoint = lastValueNow - reference;
changePct = 0;
if(reference != 0) changePct = 100 * changePoint / reference;
reboundFromLow = lastValueNow - sessionLow;
dropFromHigh = sessionHigh - lastValueNow;

// ---------- Mốc kỹ thuật gần nhất dưới / trên giá ----------
supportNear = 0;
resistanceNear = 1e10;

if(dMa10 < lastValueNow AND dMa10 > supportNear) supportNear = dMa10;
if(dMa20 < lastValueNow AND dMa20 > supportNear) supportNear = dMa20;
if(dMa50 < lastValueNow AND dMa50 > supportNear) supportNear = dMa50;
if(vwapNow < lastValueNow AND vwapNow > supportNear) supportNear = vwapNow;
if(dPrevHigh < lastValueNow AND dPrevHigh > supportNear) supportNear = dPrevHigh;
if(dPrevLow < lastValueNow AND dPrevLow > supportNear) supportNear = dPrevLow;
if(dHigh20 < lastValueNow AND dHigh20 > supportNear) supportNear = dHigh20;
if(dLow20 < lastValueNow AND dLow20 > supportNear) supportNear = dLow20;

if(dMa10 > lastValueNow AND dMa10 < resistanceNear) resistanceNear = dMa10;
if(dMa20 > lastValueNow AND dMa20 < resistanceNear) resistanceNear = dMa20;
if(dMa50 > lastValueNow AND dMa50 < resistanceNear) resistanceNear = dMa50;
if(vwapNow > lastValueNow AND vwapNow < resistanceNear) resistanceNear = vwapNow;
if(dPrevHigh > lastValueNow AND dPrevHigh < resistanceNear) resistanceNear = dPrevHigh;
if(dPrevLow > lastValueNow AND dPrevLow < resistanceNear) resistanceNear = dPrevLow;
if(dHigh20 > lastValueNow AND dHigh20 < resistanceNear) resistanceNear = dHigh20;
if(dLow20 > lastValueNow AND dLow20 < resistanceNear) resistanceNear = dLow20;

if(resistanceNear == 1e10) resistanceNear = 0;

// ---------- Xuất CSV 1 dòng ----------
if(snapshotEnable)
{
    fh = fopen(snapshotFile, "w");

    if(fh)
    {
        header = "symbol,value,reference,change,change_pct,open,high,low,rebound_from_low,drop_from_high,ma10,ma20,ma50,vwap,rsi14,macd,macd_signal,prev_high,prev_low,high20,low20,support_near,resistance_near,updated_at\n";

        line = Name() + ","
            + NumToStr(lastValueNow, 1.4, False) + ","
            + NumToStr(reference, 1.4, False) + ","
            + NumToStr(changePoint, 1.4, False) + ","
            + NumToStr(changePct, 1.4, False) + ","
            + NumToStr(sessionOpen, 1.4, False) + ","
            + NumToStr(sessionHigh, 1.4, False) + ","
            + NumToStr(sessionLow, 1.4, False) + ","
            + NumToStr(reboundFromLow, 1.4, False) + ","
            + NumToStr(dropFromHigh, 1.4, False) + ","
            + NumToStr(dMa10, 1.4, False) + ","
            + NumToStr(dMa20, 1.4, False) + ","
            + NumToStr(dMa50, 1.4, False) + ","
            + NumToStr(vwapNow, 1.4, False) + ","
            + NumToStr(dRsi14, 1.4, False) + ","
            + NumToStr(dMacd, 1.4, False) + ","
            + NumToStr(dSignal, 1.4, False) + ","
            + NumToStr(dPrevHigh, 1.4, False) + ","
            + NumToStr(dPrevLow, 1.4, False) + ","
            + NumToStr(dHigh20, 1.4, False) + ","
            + NumToStr(dLow20, 1.4, False) + ","
            + NumToStr(supportNear, 1.4, False) + ","
            + NumToStr(resistanceNear, 1.4, False) + ","
            + DateTimeToStr(LastValue(DateTime(), 1)) + "\n";

        fputs(header, fh);
        fputs(line, fh);
        fclose(fh);
    }
}

Title = EncodeColor(colorGold) + "VH MARKET LIVE SNAPSHOT" + EncodeColor(colorWhite)
    + " | " + Name()
    + " | " + NumToStr(lastValueNow, 1.2)
    + " | " + NumToStr(changePoint, 1.2)
    + " (" + NumToStr(changePct, 1.2) + "%)"
    + " | Low " + NumToStr(sessionLow, 1.2)
    + " | High " + NumToStr(sessionHigh, 1.2)
    + " | VWAP " + NumToStr(vwapNow, 1.2)
    + " | MA10 " + NumToStr(dMa10, 1.2)
    + " | MA20 " + NumToStr(dMa20, 1.2);

_SECTION_END();
